# Normalize line endings: store LF in the repository, check out LF everywhere.
* text=auto eol=lf

# Windows scripts must keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert line endings or attempt a text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary

# Lockfile is generated by npm; collapse it in diffs/language stats.
ui/package-lock.json linguist-generated=true
